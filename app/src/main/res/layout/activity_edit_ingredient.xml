<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->

        <TextView
            android:id="@+id/btnBackEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#177245"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="EDIT INGREDIENT"
            android:textColor="#177245"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Update your pantry item"
            android:textColor="#17251E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Keep your pantry information accurate and up to date."
            android:textColor="#68756E"
            android:textSize="14sp" />

        <!-- Ingredient Name -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Ingredient name"
            android:textColor="#17251E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditIngredientName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#177245"
            android:hint="e.g. Tomatoes"
            android:inputType="textCapSentences"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#17251E"
            android:textColorHint="#7B8981"
            android:textSize="16sp" />

        <!-- Quantity -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Quantity"
            android:textColor="#17251E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditQuantity"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#177245"
            android:hint="e.g. 5"
            android:inputType="numberDecimal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#17251E"
            android:textColorHint="#7B8981"
            android:textSize="16sp" />

        <!-- Unit -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Unit"
            android:textColor="#17251E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerEditUnit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp" />

        <!-- Expiry Date -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Expiry date"
            android:textColor="#17251E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#177245"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select expiry date"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#17251E"
            android:textColorHint="#7B8981"
            android:textSize="16sp" />

        <!-- Update Button -->

        <Button
            android:id="@+id/btnUpdateIngredient"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#177245"
            android:text="✓  Update Ingredient"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Delete Button -->

        <Button
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#D9534F"
            android:text="🗑  Delete Ingredient"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
